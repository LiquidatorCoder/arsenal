#!/usr/bin/env node
// arsenal's deterministic verifier.
//
// Thin shim: all generic machinery (diffing, fingerprints, root resolution) comes from
// the shared harness runtime at ~/.claude/harness/runtime/lib/. Everything repo-specific
// — which commands exist, which tier runs which — lives here and in lib/classify.mjs.
//
// Contract (doc/agents/verification.md):
//   tool/harness/verify <fast|normal|full> [--base <ref>] [--files a b ...]
//                                          [--json-out <path>] [--quiet]
//
// Exit 0 only when result === "passed". Exit 1 otherwise (failed or incomplete).
//
// THE RULE: a check is reported "passed" only if its command actually ran and actually
// exited zero. A check that could not run is "skipped" AND is listed in
// unsatisfied_required, which makes the whole run "incomplete" — never "passed". There
// is no code path here that writes a pass for a command it did not execute. Do not add
// one.
//
// Where the checks came from (all discovered in this repo, none assumed):
//   analyze         -> Makefile `analyze:` and .github/workflows/ci.yml "Static analysis"
//   test            -> Makefile `test:` and `verify-goldens:` (both are `flutter test`);
//                      CI runs it as "Verify golden snapshots"
//   example_analyze -> Makefile `get:` fetches example/ deps specifically so the demo
//                      app analyzes; CI runs `make get`
//   publish_dry_run -> arsenal is a published pub.dev package (pubspec `version:`,
//                      `repository:`, CHANGELOG.md, a screenshot carousel). This check
//                      is NOT in the repo's CI; the harness adds it at `full` only, as
//                      the release-readiness gate for the one irreversible action this
//                      repo can take. It is read-only (`--dry-run`).
//
// NOT a check here, deliberately: `dart format`. This repo has never adopted it — it is
// absent from the Makefile and from CI, and running it today would rewrite 23 of 28
// Dart files. Adding it as a gate would manufacture a failure that says nothing about
// the code. See AGENTS.md "Formatting".

import { spawnSync } from "node:child_process";
import { existsSync, mkdirSync, readFileSync, readdirSync, statSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const SCHEMA_VERSION = 3;

// Loaded in main() (dynamic import), used by the in-process `assets` check below.
let assetChecker = null;

const RUNTIME_LIB = process.env.CLAUDE_HARNESS_RUNTIME || join(homedir(), ".claude", "harness", "runtime", "lib");

async function loadRuntime(name) {
  const path = join(RUNTIME_LIB, name);
  if (!existsSync(path)) {
    process.stderr.write(
      `tool/harness/verify: harness runtime module not found: ${path}\n` +
        `The shared runtime (~/.claude/harness/runtime/) is missing or moved. Set\n` +
        `CLAUDE_HARNESS_RUNTIME to its lib/ directory, or reinstall the harness.\n`,
    );
    process.exit(2);
  }
  return import(pathToFileURL(path).href);
}

function parseArgs(argv) {
  const out = { tier: null, base: undefined, files: undefined, jsonOut: null, quiet: false };
  const rest = [...argv];
  while (rest.length > 0) {
    const a = rest.shift();
    if (a === "--base") out.base = rest.shift();
    else if (a === "--json-out") out.jsonOut = rest.shift();
    else if (a === "--quiet") out.quiet = true;
    else if (a === "--files") {
      out.files = [];
      while (rest.length > 0 && !rest[0].startsWith("--")) out.files.push(rest.shift());
    } else if (a === "-h" || a === "--help") {
      process.stdout.write("usage: tool/harness/verify <fast|normal|full> [--base <ref>] [--files <p>...] [--json-out <path>] [--quiet]\n");
      process.exit(0);
    } else if (a.startsWith("-")) {
      process.stderr.write(`tool/harness/verify: unknown flag ${a}\n`);
      process.exit(2);
    } else if (out.tier === null) out.tier = a;
    else {
      process.stderr.write(`tool/harness/verify: unexpected argument ${a}\n`);
      process.exit(2);
    }
  }
  return out;
}

// --- Toolchain resolution -------------------------------------------------------------
// arsenal pins Flutter with FVM (`.fvmrc` -> 3.41.4) and its own golden scripts
// (tool/update_goldens.sh, tool/pre_commit_goldens.sh) invoke `fvm flutter`, while the
// Makefile and CI say plain `flutter` — CI gets away with it because the workflow reads
// .fvmrc and installs exactly that version first.
//
// Locally the two are NOT interchangeable: golden PNGs are rendered by the Flutter
// engine, so a different engine revision can shift anti-aliasing and fail goldens for
// reasons that have nothing to do with the change under test. So: prefer `fvm flutter`
// whenever .fvmrc names a version FVM has cached, fall back to plain `flutter`, and
// record in the artifact which one ran and whether it matches the pin.

function toolOnPath(bin) {
  return spawnSync("command", ["-v", bin], { shell: true, encoding: "utf8" }).status === 0;
}

function pinnedFlutterVersion(cwd) {
  try {
    const v = JSON.parse(readFileSync(join(cwd, ".fvmrc"), "utf8")).flutter;
    return typeof v === "string" && v.length > 0 ? v : null;
  } catch {
    return null;
  }
}

function plainFlutterVersion() {
  const r = spawnSync("flutter", ["--version"], { encoding: "utf8", timeout: 120_000 });
  if (r.status !== 0) return null;
  const m = /Flutter (\S+)/.exec(`${r.stdout ?? ""}`);
  return m ? m[1] : null;
}

/**
 * { ok:true, bin, prefix, label, pinned, resolved, matchesPin } | { ok:false, reason }
 * `prefix` is prepended to every flutter arg list (["flutter"] for fvm, [] for plain).
 */
function resolveFlutter(cwd) {
  const pinned = pinnedFlutterVersion(cwd);
  if (pinned && toolOnPath("fvm")) {
    const cached = join(homedir(), "fvm", "versions", pinned);
    if (existsSync(cached)) {
      return { ok: true, bin: "fvm", prefix: ["flutter"], label: `fvm flutter (${pinned})`, pinned, resolved: pinned, matchesPin: true };
    }
  }
  if (toolOnPath("flutter")) {
    const resolved = plainFlutterVersion();
    return {
      ok: true,
      bin: "flutter",
      prefix: [],
      label: `flutter (${resolved ?? "unknown version"})`,
      pinned,
      resolved,
      matchesPin: pinned === null || resolved === null ? null : resolved === pinned,
    };
  }
  const detail = pinned ? `neither \`fvm\` (with ${pinned} cached; run \`fvm install ${pinned}\`) nor \`flutter\` is on PATH` : "the `flutter` CLI is not on PATH";
  return { ok: false, reason: detail };
}

// --- The repo's actual commands --------------------------------------------------------
// `available` returns null when the check can run, or a human reason string when it
// genuinely cannot — that reason is what lands in unsatisfied_required.

function hasDartTestFiles(cwd) {
  const root = join(cwd, "test");
  if (!existsSync(root)) return false;
  const stack = [root];
  while (stack.length > 0) {
    const dir = stack.pop();
    let entries;
    try {
      entries = readdirSync(dir);
    } catch {
      continue;
    }
    for (const name of entries) {
      const abs = join(dir, name);
      let st;
      try {
        st = statSync(abs);
      } catch {
        continue;
      }
      if (st.isDirectory()) stack.push(abs);
      else if (name.endsWith("_test.dart")) return true;
    }
  }
  return false;
}

// Dependencies are a precondition, not a check: the verifier never mutates the workspace,
// so it will not run `flutter pub get` for you. Missing deps are reported honestly as
// "could not run", which makes the run incomplete rather than silently failing analyze.
function depsFetched(cwd, subdir) {
  const root = subdir ? join(cwd, subdir) : cwd;
  return existsSync(join(root, ".dart_tool", "package_config.json"));
}

const CHECKS = {
  // In-process, no toolchain, milliseconds: asserts every font path in pubspec's
  // `flutter: fonts:` and every `screenshots:` path actually exists on disk. Both are
  // declarations nothing else validates until something expensive breaks — a missing
  // font renders Ahem blocks in every golden, a missing screenshot fails pub publish.
  // This repo has already shipped three releases fixing screenshot path problems
  // (CHANGELOG 0.1.0+1, 0.1.1, 0.1.2), which is why it earns a place in `fast`.
  assets: {
    inProcess: (cwd) => assetChecker.checkDeclaredAssets({ cwd }),
    description: "declared font/screenshot assets exist (pubspec.yaml)",
    source: "harness-added structural check; pubspec `flutter: fonts:` and `screenshots:`",
    available: () => null,
  },
  analyze: {
    args: ["analyze"],
    description: "flutter analyze",
    source: "Makefile `analyze:` / CI 'Static analysis'",
    available: (cwd, fl) => {
      if (!fl.ok) return fl.reason;
      if (!depsFetched(cwd)) return "dependencies are not fetched (.dart_tool/package_config.json is absent) — run `make get`";
      return null;
    },
  },
  test: {
    args: ["test"],
    description: "flutter test (widget + 21 golden snapshots)",
    source: "Makefile `test:` / `verify-goldens:` / CI 'Verify golden snapshots'",
    available: (cwd, fl) => {
      if (!fl.ok) return fl.reason;
      if (!depsFetched(cwd)) return "dependencies are not fetched (.dart_tool/package_config.json is absent) — run `make get`";
      if (!hasDartTestFiles(cwd)) return "no test files: test/ contains no *_test.dart";
      return null;
    },
  },
  example_analyze: {
    args: ["analyze"],
    subdir: "example",
    description: "flutter analyze (in example/)",
    source: "Makefile `get:` fetches example/ deps; CI runs `make get`",
    available: (cwd, fl) => {
      if (!fl.ok) return fl.reason;
      if (!existsSync(join(cwd, "example", "pubspec.yaml"))) return "example/pubspec.yaml is absent";
      if (!depsFetched(cwd, "example")) return "example/ dependencies are not fetched — run `make get`";
      return null;
    },
  },
  publish_dry_run: {
    args: ["pub", "publish", "--dry-run"],
    description: "flutter pub publish --dry-run",
    source: "harness-added release signal (arsenal is published to pub.dev); not in this repo's CI",
    // ADVISORY, not gating. `pub publish --dry-run` exits 65 on any warning, and one of
    // its warnings is "checked-in files are modified in git" — which is true of every
    // working tree mid-task. Making it required would block completion for a reason
    // that has nothing to do with the change under test. It still runs, and its output
    // is reported in full; it just does not decide pass/fail. Read it before publishing,
    // from a clean tree.
    advisory: true,
    available: (cwd, fl) => {
      if (!fl.ok) return fl.reason;
      if (!existsSync(join(cwd, "pubspec.yaml"))) return "pubspec.yaml is absent";
      return null;
    },
  },
};

const TIER_CHECKS = {
  fast: ["assets", "analyze"],
  normal: ["assets", "analyze", "test", "example_analyze"],
  full: ["assets", "analyze", "test", "example_analyze", "publish_dry_run"],
};

const CHECK_TIMEOUT_MS = 20 * 60 * 1000;

function truncate(s, n = 4000) {
  const t = (s ?? "").trimEnd();
  return t.length <= n ? t : `${t.slice(0, n)}\n...[truncated ${t.length - n} chars]`;
}

function runCheck(name, cwd, flutter, quiet) {
  const spec = CHECKS[name];
  const required = !spec.advisory;
  const unavailable = spec.available(cwd, flutter);
  if (unavailable) {
    return { name, description: spec.description, status: "skipped", required, exit_code: null, duration_ms: 0, detail: unavailable };
  }
  // In-process checks run here rather than spawning. Same honesty rule applies: the
  // check only reports "passed" when it actually ran and actually returned ok.
  if (spec.inProcess) {
    const startedAt = Date.now();
    let r;
    try {
      r = spec.inProcess(cwd);
    } catch (e) {
      const duration = Date.now() - startedAt;
      return { name, description: spec.description, status: "skipped", required, exit_code: null, duration_ms: duration, detail: `could not run: ${String(e?.message ?? e)}` };
    }
    const duration = Date.now() - startedAt;
    const status = r.ok ? "passed" : "failed";
    if (!quiet) process.stdout.write(`  ${status === "passed" ? "PASS" : "FAIL"}  ${name}  (${spec.description}, ${duration}ms)\n`);
    return { name, description: spec.description, status, required, exit_code: r.ok ? 0 : 1, duration_ms: duration, detail: r.detail ?? "" };
  }

  const runCwd = spec.subdir ? join(cwd, spec.subdir) : cwd;
  const args = [...flutter.prefix, ...spec.args];
  const startedAt = Date.now();
  const r = spawnSync(flutter.bin, args, { cwd: runCwd, encoding: "utf8", timeout: CHECK_TIMEOUT_MS, maxBuffer: 64 * 1024 * 1024 });
  const duration = Date.now() - startedAt;
  const output = `${r.stdout ?? ""}${r.stderr ?? ""}`;

  // Spawn failure or timeout is "could not run", not "failed" — an honest distinction:
  // it is not evidence the code is wrong, and it must not be reported as a pass either.
  if (r.error || r.signal) {
    const reason = r.error?.code === "ETIMEDOUT" || r.signal === "SIGTERM" ? `timed out after ${CHECK_TIMEOUT_MS}ms` : `could not run: ${r.error?.message ?? `killed by ${r.signal}`}`;
    return { name, description: spec.description, status: "skipped", required, exit_code: null, duration_ms: duration, detail: reason };
  }
  const status = r.status === 0 ? "passed" : "failed";
  if (!quiet) process.stdout.write(`  ${status === "passed" ? "PASS" : required ? "FAIL" : "WARN"}  ${name}  (${spec.description}${required ? "" : ", advisory"}, ${duration}ms)\n`);
  return { name, description: spec.description, status, required, exit_code: r.status, duration_ms: duration, detail: status === "passed" ? "" : truncate(output) };
}

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  if (!TIER_CHECKS[opts.tier]) {
    process.stderr.write(`tool/harness/verify: tier must be one of fast, normal, full (got ${opts.tier === null ? "nothing" : `"${opts.tier}"`})\n`);
    process.exit(2);
  }

  const { resolveWorktreeRoot } = await loadRuntime("reporoot.mjs");
  const { computeDiff, computeHead } = await loadRuntime("diff.mjs");
  const { workspaceFingerprint, policyFingerprint } = await loadRuntime("fingerprint.mjs");
  const libDir = join(dirname(fileURLToPath(import.meta.url)), "lib");
  const { classifyChanges, POLICY_FILES, FINGERPRINT_EXCLUDE_PREFIXES } = await import(pathToFileURL(join(libDir, "classify.mjs")).href);
  assetChecker = await import(pathToFileURL(join(libDir, "assetcheck.mjs")).href);

  const rooted = resolveWorktreeRoot({ cwd: process.cwd() });
  if (!rooted.ok) {
    process.stderr.write(`tool/harness/verify: ${rooted.reason}\n`);
    process.exit(2);
  }
  const cwd = rooted.root;

  // computeDiff returns entries ({path, status, oldPath?}), not bare paths: the
  // fingerprint needs the entries, the classifier needs the paths.
  const diff = computeDiff({ cwd, baseRefArg: opts.base, filesOverride: opts.files });
  const changedEntries = diff.changedFiles ?? [];
  const changedPaths = changedEntries.map((e) => e.path);
  const { requiredTier, reasons } = classifyChanges(changedPaths);

  const flutter = resolveFlutter(cwd);

  const scope = opts.files ? { mode: "files", base: opts.base ?? null, files: opts.files } : opts.base ? { mode: "base", base: opts.base, files: null } : { mode: "default", base: null, files: null };

  if (!opts.quiet) {
    process.stdout.write(`verify ${opts.tier} — ${changedEntries.length} changed file(s), classifier requires "${requiredTier}"\n`);
    process.stdout.write(`  toolchain: ${flutter.ok ? flutter.label : `UNAVAILABLE — ${flutter.reason}`}\n`);
    if (flutter.ok && flutter.matchesPin === false) {
      process.stdout.write(`  WARNING: .fvmrc pins Flutter ${flutter.pinned} but ${flutter.resolved} is running.\n` + `           Golden renders are engine-sensitive; failures may be toolchain drift.\n` + `           Fix with: fvm install ${flutter.pinned} && fvm use ${flutter.pinned}\n`);
    }
    if (reasons.length > 0 && requiredTier !== "fast") {
      for (const r of reasons.slice(0, 5)) process.stdout.write(`  ${requiredTier} because ${r.path}: ${r.why}\n`);
    }
  }

  const checks = [];
  for (const name of TIER_CHECKS[opts.tier]) checks.push(runCheck(name, cwd, flutter, opts.quiet));

  const unsatisfiedRequired = checks.filter((c) => c.required && c.status === "skipped").map((c) => ({ check: c.name, reason: c.detail }));
  const anyFailed = checks.some((c) => c.required && c.status === "failed");
  const advisoryFailures = checks.filter((c) => !c.required && c.status !== "passed").map((c) => ({ check: c.name, status: c.status }));
  const result = anyFailed ? "failed" : unsatisfiedRequired.length > 0 ? "incomplete" : "passed";

  const artifact = {
    schema_version: SCHEMA_VERSION,
    tier: opts.tier,
    result,
    completion_tier_satisfied: result === "passed",
    unsatisfied_required: unsatisfiedRequired,
    required_tier: requiredTier,
    verification_policy_fingerprint: policyFingerprint({ cwd, policyFiles: POLICY_FILES }),
    workspace_fingerprint: workspaceFingerprint({ cwd, changedFiles: changedEntries, excludePrefixes: FINGERPRINT_EXCLUDE_PREFIXES }),
    advisory_failures: advisoryFailures,
    verification_scope: scope,
    base: diff.base,
    verified_at_commit: computeHead({ cwd }),
    toolchain: {
      flutter_command: flutter.ok ? [flutter.bin, ...flutter.prefix].join(" ") : null,
      pinned_flutter: flutter.pinned ?? null,
      resolved_flutter: flutter.ok ? (flutter.resolved ?? null) : null,
      matches_pin: flutter.ok ? flutter.matchesPin : null,
    },
    changed_files: changedEntries,
    checks,
    generated_by: "tool/harness/verify",
    generated_at: new Date().toISOString(),
  };

  if (opts.jsonOut) {
    mkdirSync(dirname(opts.jsonOut), { recursive: true });
    writeFileSync(opts.jsonOut, `${JSON.stringify(artifact, null, 2)}\n`);
  }

  if (!opts.quiet) {
    process.stdout.write(`\nresult: ${result}  (tier ${opts.tier}, required ${requiredTier})\n`);
    for (const u of unsatisfiedRequired) process.stdout.write(`  did not run: ${u.check} — ${u.reason}\n`);
    for (const a of advisoryFailures) process.stdout.write(`  advisory (does not gate): ${a.check} ${a.status}\n`);
    for (const c of checks.filter((x) => x.status === "failed")) {
      process.stdout.write(`\n--- ${c.name} failed (exit ${c.exit_code}) ---\n${c.detail}\n`);
    }
    if (opts.jsonOut) process.stdout.write(`\nartifact: ${opts.jsonOut}\n`);
  } else {
    process.stdout.write(`${JSON.stringify(artifact)}\n`);
  }

  process.exit(result === "passed" ? 0 : 1);
}

main().catch((e) => {
  process.stderr.write(`tool/harness/verify: ${e?.stack ?? e}\n`);
  process.exit(2);
});
